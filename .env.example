# Copy this to a Replit "Secret" (or a local .env if you add python-dotenv)
# and fill in real values. The app runs fine with none of these set --
# it falls back to an in-memory database and a dev-only JWT secret.

# MongoDB Atlas connection string. Leave blank to use the in-memory store.
MONGO_URI=
MONGO_DB_NAME=interviewiq

# Change this to a long random string before deploying anywhere real.
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Flip these on only after wiring in the real model implementations
# described in backend/services/*.py
USE_REAL_CV_MODEL=false
USE_REAL_SPEECH_MODEL=false
USE_REAL_NLP_SCORER=false
